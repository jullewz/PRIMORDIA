{
  "name": "primordia",
  "version": "0.1.0",
  "description": "An artificial-life laboratory in your browser: neural-network creatures evolving by natural selection.",
  "type": "module",
  "license": "MIT",
  "author": "jullewz (https://github.com/jullewz)",
  "homepage": "https://github.com/jullewz/primordia",
  "repository": {
    "type": "git",
    "url": "https://github.com/jullewz/primordia.git"
  },
  "bugs": {
    "url": "https://github.com/jullewz/primordia/issues"
  },
  "keywords": [
    "artificial-life",
    "evolution",
    "simulation",
    "neural-network",
    "neuroevolution",
    "genetic-algorithm",
    "canvas",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "primordia": "dist/src/cli/run.js"
  },
  "files": [
    "dist",
    "index.html",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "headless": "node dist/src/cli/run.js",
    "site": "npm run build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.0"
  }
}
